{
  "name": "dsh-report-scheduler",
  "version": "0.2.0",
  "description": "Scheduled reports for DeepSeek Harness: configure everything in the settings panel (push channel, keys, cloud deploy, local scheduled task), then reports are generated on schedule and pushed to your phone",
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node selftest.mjs && node selftest-client.mjs"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-ui-settings"
      ],
      "platform": "web"
    }
  },
  "files": [
    "lib",
    "runtime",
    "runner",
    "cordis.patch.yml",
    "README.md"
  ],
  "dependencies": {
    "tweetnacl-sealedbox-js": "^1.2.0"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "scheduler",
    "report",
    "notify"
  ],
  "license": "MIT",
  "engines": {
    "node": "^22.19.0 || >=24.0.0"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-client-connection": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-runtime": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-settings": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-client-ui-slots": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-host-webserver": "^0.1.0-rc.6",
    "react": "^18.2.0"
  }
}
